# TEMPLATE only (safe to commit). The real files are GITIGNORED:
#   .env.development  -> local   (load with .\run-local.ps1)
#   .env.production   -> Railway (copy values into Service > Variables)
# See ../ENV_SETUP.md
#
# Or export each var in PowerShell:
#   $env:MAIL_USERNAME="you@gmail.com"
#   $env:MAIL_PASSWORD="abcdefghijklmnop"   # Gmail App Password, spaces optional
# Railway: set the same keys in Service > Variables.

# --- Database (local Postgres; on Railway use the internal DATABASE_URL) ---
DATABASE_URL=jdbc:postgresql://localhost:5432/freelancer?createDatabaseIfNotExist=true
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=root@123
DDL_AUTO=update

# --- Mail / OTP (Gmail SMTP via App Password) ---
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
# Gmail address that created the App Password:
MAIL_USERNAME=
# 16-char App Password you shared (enter WITHOUT committing this file):
MAIL_PASSWORD=

# --- Auth ---
# min 32 chars in production; dev default exists in application.properties
JWT_SECRET=
JWT_EXPIRATION_MS=86400000

# --- Server / CORS ---
PORT=8080
CORS_ALLOWED_ORIGINS=https://*.vercel.app,http://localhost:*,http://127.0.0.1:*
