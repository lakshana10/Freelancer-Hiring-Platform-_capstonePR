# Copy to .env and fill in. NEVER commit .env (it holds secrets).
#   copy .env.example .env   (PowerShell: Copy-Item .env.example .env)

# --- Postgres container ---
POSTGRES_DB=freelancer
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me-use-a-strong-local-password
POSTGRES_PORT=5432

# --- Backend container ---
APP_PORT=8080

# --- Mail / OTP (Gmail App Password, no spaces) ---
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=

# --- Auth (min 32 chars; generate one for shared/prod use) ---
JWT_SECRET=dev-only-insecure-secret-key-change-me-0123456789abcdef
JWT_EXPIRATION_MS=86400000

# --- CORS ---
CORS_ALLOWED_ORIGINS=https://*.vercel.app,http://localhost:*,http://127.0.0.1:*
