# ============================================================
#  CLIENT — PRODUCTION  ->  VERCEL  (Vite mode: production)
#  freelancer-frontend-react/.env.production
#
#  Auto-loaded by `npm run build`, so Vercel picks it up on deploy
#  once the URL below is real. COMMITTED ON PURPOSE.
#
#  VITE_ values are embedded into the browser bundle, so they are
#  public by design. NEVER put secrets (JWT, DB, passwords) here.
# ============================================================

# >>> REPLACE with your real Railway backend public URL, e.g.
#     https://freelancer-backend.up.railway.app
VITE_API_URL=https://<YOUR_BACKEND_SERVICE>.up.railway.app

# You can also (or instead) set VITE_API_URL in the Vercel dashboard:
#   Project -> Settings -> Environment Variables.
# A real process env var (dashboard) takes priority over this file.
