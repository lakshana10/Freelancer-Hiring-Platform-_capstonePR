# ---- Secrets -------------------------------------------------------------
# Env files may hold DB / JWT / Gmail app-password secrets. Only the
# *.example templates and the client's public VITE_* files are tracked.
.env
.env.local
.env.*.local

# Server: every env file is secret -> ignore all, re-include the template.
freelancer-backend/.env*
!freelancer-backend/.env.example

# Client: .env.development / .env.production hold only the public API
# origin and are committed on purpose (Vite + Vercel read them).

# Playwright MCP session artifacts (screenshots, console logs)
.playwright-mcp/

# Playwright test runner output (traces, reports)
freelancer-frontend-react/test-results/
freelancer-frontend-react/playwright-report/

# Build outputs
node_modules/
freelancer-frontend-react/dist/
freelancer-frontend-react/node_modules/
freelancer-backend/target/

# OS / editors
.DS_Store
Thumbs.db
.vscode/
.idea/
